// --- Order Packaging Header (Links Invoice to Details) ---
model OrderPackagingHeader {
  id Int @id @default(autoincrement())

  // Link to the final legal document (1:1 relationship)
  invoice_id Int?
  invoice    InvoiceMaster? @relation(fields: [invoice_id], references: [id])

  complementary_id Int? // NEW FIELD
  complementary    ComplimentaryMaster? @relation(fields: [complementary_id], references: [id])

  // Audit
  user_id    Int
  user       UserMaster @relation(fields: [user_id], references: [id])
  created_at DateTime   @default(now()) @db.Timestamptz()

  // Relationships
  details           OrderPackagingDetail[]
  orderPackagingBox OrderPackagingBox[]

  @@map("order_packaging_header")
}

// --- Order Packaging Detail (Calculated Box Components) ---
model OrderPackagingDetail {
  id Int @id @default(autoincrement())

  // Link to Header
  order_packaging_header_id Int
  header                    OrderPackagingHeader @relation(fields: [order_packaging_header_id], references: [id])

  // Link to the box unit used
  box_unit_id Int
  boxUnit     BoxUnitMaster @relation(fields: [box_unit_id], references: [id])

  // Result Fields
  quantity_used Int // Number of boxes of this size used in the solution

  quantity_packaged Int      @default(1) // quantityy in box
  // Audit
  created_at        DateTime @default(now()) @db.Timestamptz()

  // Ensures uniqueness per box type within a single packaging run
  @@unique([order_packaging_header_id, box_unit_id])
  @@map("order_packaging_detail")
}

// --- New Model: One Record Per Physical Box ---
model OrderPackagingBox {
  id Int @id @default(autoincrement())

  // Link to the overall packing run
  order_packaging_header_id Int
  header                    OrderPackagingHeader @relation(fields: [order_packaging_header_id], references: [id])

  // Box-specific details
  box_unit_id Int
  boxUnit     BoxUnitMaster @relation(fields: [box_unit_id], references: [id])

  // 1] Box Sequence No: Auto-calculated by the algorithm.
  box_sequence Int @db.Integer

  // 2] This box contains: Stores the product codes and quantities packed in THIS box.
  // Example: [{"product_code": "MV", "qty": 2}, {"product_code": "NI", "qty": 1}]
  contents        Json              @db.JsonB
  CourierShipment CourierShipment[]

  // Ensures Box Sequence is unique for a given packing plan
  @@unique([order_packaging_header_id, box_sequence])
  @@map("order_packaging_box")
}


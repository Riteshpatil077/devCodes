// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}


model CompanyMaster {
  id                  Int             @id @default(autoincrement())
  company_name        String          @unique @db.VarChar(255)
  company_address     String
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  updated_at          DateTime        @updatedAt @db.Timestamptz(6)
  status              String          @default("active")
  company_email_main  String?         @db.VarChar(100)
  company_email_other String?         @db.VarChar(100)
  company_gstin       String?         @db.VarChar(100)
  company_logo_url    String?         @db.VarChar(255)
  company_mobile      String?         @db.VarChar(15)
  company_pan_number  String?         @db.VarChar(100)
  company_phone       String?         @db.VarChar(15)
  company_sign_url    String?         @db.VarChar(255)
  company_website     String?         @db.VarChar(100)
  other_contact       String?         @db.VarChar(15)
  registration_no     String?         @db.VarChar(100)
  atpost_id           Int             @default(1)
  country_id          Int             @default(1)
  district_id         Int             @default(1)
  pincode             String          @default("400001") @db.VarChar(10)
  state_id            Int             @default(1)
  taluka_id           Int?            @default(1)
  atpost              AtPostMaster    @relation(fields: [atpost_id], references: [id])
  country             CountryMaster   @relation(fields: [country_id], references: [id])
  district            DistrictMaster  @relation(fields: [district_id], references: [id])
  state               StateMaster     @relation(fields: [state_id], references: [id])
  taluka              TalukaMaster?   @relation(fields: [taluka_id], references: [id])
  invoiceMaster       InvoiceMaster[]
  orderMasters        OrderMaster[]
  users               UserMaster[]

  @@map("company_master")
}

model UserMaster {
  id                        Int                         @id @default(autoincrement())
  display_name              String                      @db.VarChar(255)
  user_name                 String                      @unique @db.VarChar(100)
  password_hash             String
  companyId                 Int
  status                    String                      @db.VarChar(20)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @updatedAt @db.Timestamptz(6)
  role_id                   Int?
  BoxUnitMaster             BoxUnitMaster[]
  BankAccountTypeMaster     BankAccountTypeMaster[]
  BankDetailMaster          BankDetailMaster[]
  ChildMenuMaster           ChildMenuMaster[]
  courierServiceMaster      CourierServiceMaster[]
  CustomerCategoryMaster    CustomerCategoryMaster[]
  CustomerMaster            CustomerMaster[]
  CustomerSubCategoryMaster CustomerSubCategoryMaster[]
  DesignationMaster         DesignationMaster[]
  HsnCodeMaster             HsnCodeMaster[]
  invoiceMasters            InvoiceMaster[]
  MenuMaster                MenuMaster[]
  OrderMaster               OrderMaster[]
  permissions               PermissionMaster[]          @relation("PermissionUser")
  ProductCategoryMaster     ProductCategoryMaster[]
  ProductMaster             ProductMaster[]
  ProductSubCategoryMaster  ProductSubCategoryMaster[]
  //ReceiptDetail             ReceiptDetail[]
  ReceiptMaster             ReceiptMaster[]
  roleMasters               RoleMaster[]                @relation("RoleUser")
  SaleMaster                SaleRateMaster[]
  ServiceMaster             ServiceMaster[]
  SubMenuMaster             SubMenuMaster[]
  SubscriptionItemDetail    SubscriptionItemDetail[]
  SubscriptionMaster        SubscriptionMaster[]
  SubcriptionPeriodMaster   SubscriptionPeriodMaster[]
  SubscriptionRateMaster    SubscriptionRateMaster[]
  UnitMaster                UnitMaster[]
  company                   CompanyMaster               @relation(fields: [companyId], references: [id])
  role                      RoleMaster?                 @relation(fields: [role_id], references: [id])
  // Relationships
  OrderPackaginHeader       OrderPackagingHeader[]
  invoiceRejectionHistories InvoiceRejectionHistory[]
  JournalEntry              JournalEntry[]
  receiptInvoiceDetails     ReceiptInvoiceDetail[]
  advanceAdjustmentType     AdvanceAdjustmentType[]
  documentCategory          DocumentCategory[]
  documentUpload            DocumentUpload[]
  otherCommunicator         OtherCommunicator[]

  @@map("user_master")
}

model CountryMaster {
  id                               Int                                @id @default(autoincrement())
  country_name                     String                             @unique @db.VarChar(100)
  country_code                     String                             @unique @db.VarChar(10)
  status                           String                             @db.VarChar(20)
  created_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                           @updatedAt @db.Timestamptz(6)
  CompanyMaster                    CompanyMaster[]
  courierServiceMaster             CourierServiceMaster[]
  CustomerMaster                   CustomerMaster[]
  orderDeliveryAddress             OrderDeliveryAddress[]
  StateMaster                      StateMaster[]
  subscriptionOrderDeliveryAddress SubscriptionOrderDeliveryAddress[]
  otherCommunicator                OtherCommunicator[]

  @@map("country_master")
}

model StateMaster {
  id                               Int                                @id @default(autoincrement())
  state_name                       String                             @unique @db.VarChar(100)
  state_code                       String                             @unique @db.VarChar(10)
  countryId                        Int
  status                           String                             @db.VarChar(20)
  created_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                           @updatedAt @db.Timestamptz(6)
  is_union_territory               Boolean                            @default(false)
  CompanyMaster                    CompanyMaster[]
  courierServiceMaster             CourierServiceMaster[]
  CustomerMaster                   CustomerMaster[]
  DistrictMaster                   DistrictMaster[]
  orderDeliveryAddress             OrderDeliveryAddress[]
  country                          CountryMaster                      @relation(fields: [countryId], references: [id])
  subscriptionOrderDeliveryAddress SubscriptionOrderDeliveryAddress[]
  otherCommunicator                OtherCommunicator[]

  @@map("state_master")
}

model DistrictMaster {
  id                               Int                                @id @default(autoincrement())
  district_name                    String                             @db.VarChar(100)
  district_code                    String                             @db.VarChar(10)
  stateId                          Int
  status                           String                             @db.VarChar(20)
  created_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                           @updatedAt @db.Timestamptz(6)
  CompanyMaster                    CompanyMaster[]
  courierServiceMaster             CourierServiceMaster[]
  CustomerMaster                   CustomerMaster[]
  state                            StateMaster                        @relation(fields: [stateId], references: [id])
  orderDeliveryAddress             OrderDeliveryAddress[]
  subscriptionOrderDeliveryAddress SubscriptionOrderDeliveryAddress[]
  TalukaMaster                     TalukaMaster[]
  otherCommunicator                OtherCommunicator[]

  @@map("district_master")
}

model TalukaMaster {
  id                               Int                                @id @default(autoincrement())
  taluka_name                      String                             @db.VarChar(100)
  taluka_code                      String                             @db.VarChar(10)
  districtId                       Int
  status                           String                             @db.VarChar(20)
  created_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                           @updatedAt @db.Timestamptz(6)
  AtPostMaster                     AtPostMaster[]
  CompanyMaster                    CompanyMaster[]
  courierServiceMaster             CourierServiceMaster[]
  CustomerMaster                   CustomerMaster[]
  orderDeliveryAddress             OrderDeliveryAddress[]
  subscriptionOrderDeliveryAddress SubscriptionOrderDeliveryAddress[]
  district                         DistrictMaster                     @relation(fields: [districtId], references: [id])
  otherCommunicator                OtherCommunicator[]

  @@map("taluka_master")
}

model AtPostMaster {
  id                               Int                                @id @default(autoincrement())
  atpost_name                      String                             @db.VarChar(100)
  atpost_code                      String                             @db.VarChar(20)
  talukaId                         Int
  status                           String                             @db.VarChar(20)
  created_at                       DateTime                           @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                           @updatedAt @db.Timestamptz(6)
  taluka                           TalukaMaster                       @relation(fields: [talukaId], references: [id])
  CompanyMaster                    CompanyMaster[]
  courierServiceMaster             CourierServiceMaster[]
  CustomerMaster                   CustomerMaster[]
  orderDeliveryAddress             OrderDeliveryAddress[]
  subscriptionOrderDeliveryAddress SubscriptionOrderDeliveryAddress[]
  otherCommunicator                OtherCommunicator[]

  @@map("atpost_master")
}

model CustomerCategoryMaster {
  id             Int                         @id @default(autoincrement())
  category_name  String                      @unique @db.VarChar(100)
  user_id        Int
  status         String                      @default("ACTIVE") @db.VarChar(20)
  created_at     DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime                    @updatedAt @db.Timestamptz(6)
  user           UserMaster                  @relation(fields: [user_id], references: [id])
  CustomerMaster CustomerMaster[]
  subcategories  CustomerSubCategoryMaster[]

  @@map("customer_category_master")
}

model CustomerSubCategoryMaster {
  id               Int                    @id @default(autoincrement())
  subcategory_name String                 @db.VarChar(100)
  user_id          Int
  category_id      Int
  status           String                 @default("ACTIVE") @db.VarChar(20)
  created_at       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at       DateTime               @updatedAt @db.Timestamptz(6)
  CustomerMaster   CustomerMaster[]
  category         CustomerCategoryMaster @relation(fields: [category_id], references: [id])
  user             UserMaster             @relation(fields: [user_id], references: [id])

  @@map("customer_sub_category_master")
}

model SequenceMaster {
  id            Int    @id @default(autoincrement())
  sequence_name String @unique @db.VarChar(50)
  next_value    Int    @default(1)

  @@map("sequence_master")
}

model CustomerMaster {
  id                             Int                           @id @default(autoincrement())
  customer_code                  String                        @unique @db.VarChar(30)
  customer_name                  String                        @db.VarChar(500)
  customer_address               String?
  reg_no                         String?                       @unique @db.VarChar(50)
  pan                            String?                       @db.VarChar(10)
  gstin                          String?                       @db.VarChar(30)
  pincode                        String?                       @db.VarChar(10)
  status                         String                        @default("ACTIVE") @db.VarChar(20)
  created_at                     DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                      @updatedAt @db.Timestamptz(6)
  country_id                     Int
  state_id                       Int
  district_id                    Int
  taluka_id                      Int
  at_post_id                     Int
  category_id                    Int
  subcategory_id                 Int
  user_id                        Int
  opening_balance                Decimal                       @default(0.0) @db.Decimal(12, 2)
  alternate_mobile_number        String?                       @db.VarChar(15)
  email                          String?                       @db.VarChar(100)
  mobile_number                  String?                       @db.VarChar(15)
  website                        String?                       @db.VarChar(100)
  opening_balance_effective_date DateTime?                     @db.Date
  CustomerContactDetailMaster    CustomerContactDetailMaster[]
  at_post                        AtPostMaster                  @relation(fields: [at_post_id], references: [id])
  category                       CustomerCategoryMaster        @relation(fields: [category_id], references: [id])
  country                        CountryMaster                 @relation(fields: [country_id], references: [id])
  district                       DistrictMaster                @relation(fields: [district_id], references: [id])
  state                          StateMaster                   @relation(fields: [state_id], references: [id])
  subcategory                    CustomerSubCategoryMaster     @relation(fields: [subcategory_id], references: [id])
  taluka                         TalukaMaster                  @relation(fields: [taluka_id], references: [id])
  user                           UserMaster                    @relation(fields: [user_id], references: [id])
  OrderMaster                    OrderMaster[]
  ReceiptMaster                  ReceiptMaster[]
  SubscriptionMaster             SubscriptionMaster[]
  JournalEntry                   JournalEntry[]
  ReceiptInvoiceDetail           ReceiptInvoiceDetail[]
  InvoiceMaster                  InvoiceMaster[]
  documentUpload                 DocumentUpload[]

  @@map("customer_master")
}

model ServiceMaster {
  id                     Int                      @id @default(autoincrement())
  service_name           String                   @unique @db.VarChar(100)
  status                 String                   @default("ACTIVE") @db.VarChar(20)
  user_id                Int
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @updatedAt @db.Timestamptz(6)
  ProductCategoryMaster  ProductCategoryMaster[]
  ProductMaster          ProductMaster[]
  SaleMaster             SaleRateMaster[]
  user                   UserMaster               @relation(fields: [user_id], references: [id])
  SubscriptionRateMaster SubscriptionRateMaster[]

  @@map("service_master")
}

model ProductCategoryMaster {
  id                     Int                        @id @default(autoincrement())
  product_category_name  String                     @db.VarChar(150)
  category_type          String?                    @db.VarChar(50)
  service_id             Int
  user_id                Int
  status                 String                     @default("ACTIVE") @db.VarChar(20)
  created_at             DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                   @updatedAt @db.Timestamptz(6)
  // NEW HSN Linkage:
  hsn_id                 Int? // Link HSN/GST Rate to the Category
  hsnCode                HsnCodeMaster?             @relation(fields: [hsn_id], references: [id])
  service                ServiceMaster              @relation(fields: [service_id], references: [id])
  user                   UserMaster                 @relation(fields: [user_id], references: [id])
  ProductMaster          ProductMaster[]
  productSubcategories   ProductSubCategoryMaster[]
  SaleMaster             SaleRateMaster[]
  SubscriptionRateMaster SubscriptionRateMaster[]

  @@map("product_category_master")
}

model ProductSubCategoryMaster {
  id                        Int                      @id @default(autoincrement())
  product_sub_category_name String                   @db.VarChar(150)
  product_category_id       Int?
  user_id                   Int
  status                    String                   @default("ACTIVE") @db.VarChar(20)
  created_at                DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                 @updatedAt @db.Timestamptz(6)
  ProductMaster             ProductMaster[]
  product_category          ProductCategoryMaster?   @relation(fields: [product_category_id], references: [id])
  user                      UserMaster               @relation(fields: [user_id], references: [id])
  SaleMaster                SaleRateMaster[]
  SubscriptionRateMaster    SubscriptionRateMaster[]

  @@map("product_sub_category_master")
}

model ProductMaster {
  id                     Int                      @id @default(autoincrement())
  product_name           String                   @db.VarChar(255)
  product_code           String                   @db.VarChar(50)
  product_specification  String?
  service_id             Int
  product_category_id    Int
  product_subcategory_id Int
  user_id                Int
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @updatedAt @db.Timestamptz(6)
  status                 String                   @default("ACTIVE") @db.VarChar(20)
  // hsn_id                 Int?
  OrderItemDetail        OrderItemDetail[]
  // hsnCode                HsnCodeMaster?           @relation(fields: [hsn_id], references: [id])
  productCategory        ProductCategoryMaster    @relation(fields: [product_category_id], references: [id])
  productSubCategory     ProductSubCategoryMaster @relation(fields: [product_subcategory_id], references: [id])
  service                ServiceMaster            @relation(fields: [service_id], references: [id])
  user                   UserMaster               @relation(fields: [user_id], references: [id])
  SaleMaster             SaleRateMaster[]
  SubscriptionItemDetail SubscriptionItemDetail[]
  SubscriptionRateMaster SubscriptionRateMaster[]

  // @@unique([product_name, product_category_id])
  @@map("product_master")
}

model DesignationMaster {
  id                          Int                           @id @default(autoincrement())
  designation_name            String                        @unique @db.VarChar(100)
  status                      String                        @default("ACTIVE") @db.VarChar(20)
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                      @updatedAt @db.Timestamptz(6)
  user_id                     Int
  CustomerContactDetailMaster CustomerContactDetailMaster[]
  user                        UserMaster                    @relation(fields: [user_id], references: [id])

  @@map("designation_master")
}

model CustomerContactDetailMaster {
  id                    Int                  @id @default(autoincrement())
  contact_person_name   String               @db.VarChar(255)
  contact_person_number String               @db.VarChar(15)
  contact_type          String               @db.VarChar(50)
  contact_person_email  String?              @db.VarChar(100)
  customer_id           Int
  designation_id        Int
  status                String               @default("ACTIVE") @db.VarChar(20)
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime             @updatedAt @db.Timestamptz(6)
  customer              CustomerMaster       @relation(fields: [customer_id], references: [id])
  designation           DesignationMaster    @relation(fields: [designation_id], references: [id])
  OrderMaster           OrderMaster[]
  SubscriptionMaster    SubscriptionMaster[]

  @@map("customer_contact_detail_master")
}

model SaleRateMaster {
  id                     Int                      @id @default(autoincrement())
  sale_rate              Decimal                  @db.Decimal(10, 2)
  service_id             Int
  product_category_id    Int
  product_subcategory_id Int
  product_id             Int
  user_id                Int
  status                 String                   @default("ACTIVE")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @updatedAt @db.Timestamptz(6)
  productCategory        ProductCategoryMaster    @relation(fields: [product_category_id], references: [id])
  product                ProductMaster            @relation(fields: [product_id], references: [id])
  productSubCategory     ProductSubCategoryMaster @relation(fields: [product_subcategory_id], references: [id])
  service                ServiceMaster            @relation(fields: [service_id], references: [id])
  user                   UserMaster               @relation(fields: [user_id], references: [id])

  @@unique([service_id, product_category_id, product_subcategory_id, product_id])
  @@map("sale_rate_master")
}

model HsnCodeMaster {
  id                     Int                      @id @default(autoincrement())
  hsn_code               String                   @db.VarChar(50)
  description            String?
  gst_rate               Decimal                  @db.Decimal(4, 2)
  effective_date         DateTime                 @db.Date
  user_id                Int
  status                 String                   @default("ACTIVE")
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @updatedAt @db.Timestamptz(6)
  user                   UserMaster               @relation(fields: [user_id], references: [id])
  OrderItemDetail        OrderItemDetail[]
  // productMasters         ProductMaster[]
  productCategoryMaster  ProductCategoryMaster[]
  SubscriptionItemDetail SubscriptionItemDetail[]

  @@unique([hsn_code, effective_date])
  @@map("hsn_code_master")
}

model UnitMaster {
  id         Int        @id @default(autoincrement())
  unit_name  String     @unique @db.VarChar(50)
  user_id    Int
  status     String     @default("ACTIVE") @db.VarChar(20)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @updatedAt @db.Timestamptz(6)
  user       UserMaster @relation(fields: [user_id], references: [id])

  @@map("unit_master")
}

model BoxUnitMaster {
  id                    Int                    @id @default(autoincrement())
  box_unit              String                 @unique @db.VarChar(50)
  user_id               Int
  status                String                 @default("ACTIVE") @db.VarChar(20)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @updatedAt @db.Timestamptz(6)
  user                  UserMaster             @relation(fields: [user_id], references: [id])
  // Relationships
  OrderPackagingDetails OrderPackagingDetail[]
  orderPackagingBox     OrderPackagingBox[]
}

model OrderMaster {
  id                         Int      @id @default(autoincrement())
  customer_id                Int
  order_voucher_no           String   @db.VarChar(50)
  order_date                 DateTime @db.Date
  customer_contact_detail_id Int?

  sub_total             Decimal @db.Decimal(12, 2)
  total_tax_amount      Decimal @db.Decimal(12, 2)
  courier_rate          Decimal @default(0.0) @db.Decimal(10, 2)
  courier_charges_total Decimal @default(0.0) @db.Decimal(10, 2)
  grand_total_amount    Decimal @db.Decimal(12, 2)
  user_id               Int
  is_complementary      Boolean @default(false) // ?? ADD THIS FIELD

  status               String  @default("PENDING") @db.VarChar(20)
  // NEW AUDIT FIELDS
  confirmation_method  String? @db.VarChar(50) // WHATSAPP, EMAIL, etc.
  rejection_reason     String? @db.Text
  confirmation_comment String? @db.Text

  created_at            DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                     @updatedAt @db.Timestamptz(6)
  company_id            Int                          @default(1)
  invoiceMaster         InvoiceMaster?               @relation("OrderToInvoice")
  complementaryMaster   ComplimentaryMaster?         @relation("OrderToComplementary")
  deliveryAddress       OrderDeliveryAddress?
  items                 OrderItemDetail[]
  company               CompanyMaster                @relation(fields: [company_id], references: [id])
  customerContactDetail CustomerContactDetailMaster? @relation(fields: [customer_contact_detail_id], references: [id])

  customer CustomerMaster @relation(fields: [customer_id], references: [id])
  user     UserMaster     @relation(fields: [user_id], references: [id])

  @@map("order_master")
}

model OrderDeliveryAddress {
  id               Int            @id @default(autoincrement())
  order_id         Int            @unique
  delivery_address String?
  country_id       Int
  state_id         Int
  district_id      Int
  taluka_id        Int
  at_post_id       Int
  pin_code         String?        @db.VarChar(10)
  at_post          AtPostMaster   @relation(fields: [at_post_id], references: [id])
  country          CountryMaster  @relation(fields: [country_id], references: [id])
  district         DistrictMaster @relation(fields: [district_id], references: [id])
  order            OrderMaster    @relation(fields: [order_id], references: [id])
  state            StateMaster    @relation(fields: [state_id], references: [id])
  taluka           TalukaMaster   @relation(fields: [taluka_id], references: [id])

  @@map("order_delivery_address")
}

model OrderItemDetail {
  id              Int     @id @default(autoincrement())
  order_id        Int
  product_id      Int
  rate            Decimal @db.Decimal(10, 2)
  quantity        Int
  discount_rate   Decimal @default(0.0) @db.Decimal(4, 2)
  discount_amount Decimal @default(0.0) @db.Decimal(10, 2)

  taxable_amount    Decimal       @db.Decimal(12, 2)
  hsn_id_snapshot   Int
  gst_rate_snapshot Decimal       @db.Decimal(4, 2)
  total_tax_amount  Decimal       @db.Decimal(10, 2)
  cgst_rate         Decimal       @db.Decimal(4, 2)
  cgst_amount       Decimal       @db.Decimal(10, 2)
  sgst_rate         Decimal       @db.Decimal(4, 2)
  sgst_amount       Decimal       @db.Decimal(10, 2)
  igst_rate         Decimal       @db.Decimal(4, 2)
  igst_amount       Decimal       @db.Decimal(10, 2)
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  hsnCode           HsnCodeMaster @relation(fields: [hsn_id_snapshot], references: [id])
  Order             OrderMaster   @relation(fields: [order_id], references: [id])
  product           ProductMaster @relation(fields: [product_id], references: [id])

  @@map("order_item_detail")
}

model BankAccountTypeMaster {
  id                Int                @id @default(autoincrement())
  account_type_name String             @unique @db.VarChar(50)
  abbreviation      String             @unique @db.VarChar(10)
  user_id           Int
  status            String             @default("ACTIVE") @db.VarChar(20)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @updatedAt @db.Timestamptz(6)
  user              UserMaster         @relation(fields: [user_id], references: [id])
  bankDetailMasters BankDetailMaster[]

  @@map("bank_account_type_master")
}

model BankDetailMaster {
  id                             Int                   @id @default(autoincrement())
  account_name                   String                @db.VarChar(255)
  bank_name                      String                @db.VarChar(255)
  branch_name                    String                @db.VarChar(255)
  branch_address                 String?
  phone                          String?               @db.VarChar(20)
  email                          String?               @db.VarChar(100)
  account_number                 String                @unique @db.VarChar(50)
  ifs_code                       String                @unique @db.VarChar(20)
  option_flag                    String?               @db.VarChar(50)
  account_type_id                Int
  user_id                        Int
  created_at                     DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime              @updatedAt @db.Timestamptz(6)
  status                         String                @default("ACTIVE") @db.VarChar(20)
  opening_balance                Decimal               @default(0.0) @db.Decimal(12, 2)
  opening_balance_effective_date DateTime?             @db.Date
  account_type                   BankAccountTypeMaster @relation(fields: [account_type_id], references: [id])
  user                           UserMaster            @relation(fields: [user_id], references: [id])
  //ReceiptDetail                  ReceiptDetail[]
  ReceiptMaster                  ReceiptMaster[]

  @@map("bank_detail_master")
}

model InvoiceMaster {
  id                    Int                       @id @default(autoincrement())
  invoice_number        String                    @unique @db.VarChar(50)
  invoice_date          DateTime                  @db.Date
  sale_order_id         Int?                      @unique
  grand_total_amount    Decimal                   @db.Decimal(12, 2)
  paid_amount           Decimal                   @default(0.0) @db.Decimal(12, 2)
  balance_due           Decimal                   @default(0.0) @db.Decimal(12, 2) //(grand_total_amount - paid_amount)  auto_calculated
  is_opening_balance    Boolean                   @default(false)
  status                String                    @default("ISSUED") @db.VarChar(20)
  payment_status        String                    @default("UNPAID") @db.VarChar(20)
  // NEW AUDIT FIELDS
  user_id               Int
